# derived leaf skeletons — regenerable from schemas via scripts/regen-mapping.sh
mapping/_leaves_*.csv
__pycache__/
*.pyc

# local knowledge vault (crawled MII docs + ingested reference notes) — derived
# from local sources, not republished on the public repo
knowledge/

# adversarial-review raw outputs (kept local)
docs/REVIEW-*.err

# derived mapping views (regenerable: export_xlsx.py / render_table.py)
mapping/mapping-table.xlsx
docs/mapping-table.html
docs/_table.json
out/

# SU-TermServ client certs (never commit private keys)
infra/mii-termserv-proxy/certs/*
!infra/mii-termserv-proxy/certs/.gitkeep

# terminology-check tx cache
scripts/.tx_cache.json

# genomde2fhir
genomde2fhir/.venv/
genomde2fhir/build/
genomde2fhir/src/*.egg-info/
dist/
out/e2e-2027/
infra/matchbox-2027/package-cache/*
!infra/matchbox-2027/package-cache/.gitkeep
infra/matchbox-2027/config/packages/

# review / crawl scratch logs
docs/*.err
docs/_crawl.log
